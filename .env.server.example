# Server variables. Set on the claimed Space with:  npx sf env import .env.server --secret --space <space-id>
# (Never commit a real .env.server.)

# Discogs personal access token (free: discogs.com/settings/developers). Unlocks browsing by
# genre / era / label and search. Release, master and artist lookups work without it.
DISCOGS_TOKEN=

# A passphrase Brendan types once in the app. Required for saving Top Tens and playlists.
# Leave empty only while testing: then anyone who finds the URL can write.
OWNER_KEY=

# Spotify. Create an app at developer.spotify.com; redirect URI = https://<your-space>/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APP_ORIGIN=https://crate-digger.view.fast
