# Server variables. Set on the claimed Space with:  npx sf env import .env.server --secret --space <space-id>
# (Never commit a real .env.server.)

# Optional: Discogs personal access token (free: discogs.com/settings/developers). Turns on the
# "Read the sleeve" panel (label, catalogue number, format, notes) on any record.
DISCOGS_TOKEN=

# A passphrase Brendan types once in the app. Required for saving Top Tens and playlists.
# Leave empty only while testing: then anyone who finds the URL can write.
OWNER_KEY=

# Required: Spotify is the catalogue. Create an app at developer.spotify.com; redirect URI =
# https://<your-space>/api/spotify/callback; add Brendan's account under User Management.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
APP_ORIGIN=https://crate-digger.view.fast
